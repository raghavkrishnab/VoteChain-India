```jsx
import { useState } from 'react';
import { useAuth } from '../context/AuthContext';
import { Link, useNavigate } from 'react-router-dom';

export default function Login() {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [err, setErr] = useState('');
  const [loading, setLoading] = useState(false);

  const { login, walletLogin } = useAuth();
  const navigate = useNavigate();

  const submit = async (e) => {
    e.preventDefault();
    setErr('');
    setLoading(true);

    try {
      await login(email, password);
      navigate('/dashboard');
    } catch (error) {
      setErr(
        error.response?.data?.message ||
        error.message ||
        'Login failed'
      );
    } finally {
      setLoading(false);
    }
  };

  const handleWalletLogin = async () => {
    setErr('');
    setLoading(true);

    try {
      await walletLogin();
      navigate('/dashboard');
    } catch (error) {
      setErr(error.message || 'Wallet login failed');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-slate-950 text-white flex items-center justify-center px-4 py-10 relative overflow-hidden">

      {/* Background glow */}
      <div className="absolute top-0 left-0 w-72 h-72 bg-indigo-600 rounded-full blur-3xl opacity-20" />

      <div className="absolute bottom-0 right-0 w-72 h-72 bg-cyan-500 rounded-full blur-3xl opacity-10" />

      <div className="relative z-10 w-full max-w-5xl grid md:grid-cols-2 gap-10 items-center">

        {/* LEFT SIDE */}
        <div className="hidden md:block">

          <div className="inline-flex items-center gap-2 bg-indigo-500/10 border border-indigo-400/20 rounded-full px-4 py-2 text-sm text-indigo-300 mb-6">
            <span className="w-2 h-2 bg-emerald-400 rounded-full animate-pulse" />
            Voting Network Online
          </div>

          <h1 className="text-5xl font-bold leading-tight">
            Your Vote.
            <br />

            <span className="text-indigo-400">
              Your Voice.
            </span>
          </h1>

          <p className="text-slate-400 mt-5 max-w-md leading-relaxed">
            Secure digital voting with AI-assisted verification
            and blockchain-backed transaction records.
          </p>

          {/* Voting visual */}
          <div className="relative h-64 mt-8">

            <div className="absolute left-20 top-8 w-44 h-44 rounded-full bg-indigo-500/20 blur-2xl" />

            <div className="absolute left-24 top-4 w-44 h-44 rounded-full border border-indigo-400/30 bg-indigo-500/10 backdrop-blur-xl flex items-center justify-center shadow-2xl">
              <div className="text-6xl">
                🗳️
              </div>
            </div>

            <div className="absolute left-0 top-24 bg-white/5 border border-white/10 rounded-xl px-4 py-3 backdrop-blur-xl">
              <div className="text-xs text-slate-500">
                BLOCK
              </div>
              <div className="font-bold">
                #8A41
              </div>
            </div>

            <div className="absolute right-4 top-8 bg-white/5 border border-white/10 rounded-xl px-4 py-3 backdrop-blur-xl">
              <div className="text-xs text-slate-500">
                NETWORK
              </div>
              <div className="font-bold text-emerald-400">
                ONLINE
              </div>
            </div>

            <div className="absolute right-12 bottom-4 bg-white/5 border border-white/10 rounded-xl px-4 py-3 backdrop-blur-xl">
              <div className="text-xs text-slate-500">
                AI CHECK
              </div>
              <div className="font-bold text-cyan-300">
                READY
              </div>
            </div>

          </div>

          <div className="flex flex-wrap gap-3">

            <span className="bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-sm text-slate-300">
              Blockchain
            </span>

            <span className="bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-sm text-slate-300">
              AI Verification
            </span>

            <span className="bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-sm text-slate-300">
              Secure Voting
            </span>

          </div>

        </div>

        {/* LOGIN CARD */}
        <div className="w-full max-w-md mx-auto">

          <div className="bg-white/5 border border-white/10 rounded-3xl p-7 backdrop-blur-xl shadow-2xl">

            {/* Mobile logo */}
            <div className="md:hidden text-center mb-6">
              <div className="text-5xl mb-3">
                🗳️
              </div>

              <h1 className="text-2xl font-bold">
                Blockchain Voting
              </h1>
            </div>

            <div className="mb-7">

              <p className="text-indigo-400 text-sm font-medium">
                Welcome back
              </p>

              <h2 className="text-3xl font-bold mt-1">
                Sign in
              </h2>

              <p className="text-slate-400 text-sm mt-2">
                Access your secure voting dashboard.
              </p>

            </div>

            {/* Error */}
            {err && (
              <div className="mb-5 p-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-300 text-sm">
                {err}
              </div>
            )}

            <form onSubmit={submit} className="space-y-4">

              {/* Email */}
              <div>

                <label className="block text-sm text-slate-300 mb-2">
                  Email
                </label>

                <input
                  type="email"
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                  placeholder="you@example.com"
                  required
                  className="w-full bg-black/20 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-slate-600 outline-none focus:border-indigo-500"
                />

              </div>

              {/* Password */}
              <div>

                <label className="block text-sm text-slate-300 mb-2">
                  Password
                </label>

                <input
                  type="password"
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  placeholder="Enter your password"
                  required
                  className="w-full bg-black/20 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-slate-600 outline-none focus:border-indigo-500"
                />

              </div>

              {/* Login */}
              <button
                type="submit"
                disabled={loading}
                className="w-full bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 rounded-xl py-3 font-semibold transition"
              >
                {loading ? 'Signing in...' : 'Sign in'}
              </button>

            </form>

            {/* Divider */}
            <div className="flex items-center gap-3 my-6">

              <div className="flex-1 h-px bg-white/10" />

              <span className="text-xs text-slate-500">
                OR
              </span>

              <div className="flex-1 h-px bg-white/10" />

            </div>

            {/* MetaMask */}
            <button
              type="button"
              onClick={handleWalletLogin}
              disabled={loading}
              className="w-full border border-orange-400/20 bg-orange-500/5 hover:bg-orange-500/10 disabled:opacity-50 rounded-xl py-3 flex items-center justify-center gap-3 transition"
            >
              <span className="text-xl">
                🦊
              </span>

              <span>
                Sign in with MetaMask
              </span>

            </button>

            {/* Register */}
            <p className="text-center text-sm text-slate-500 mt-6">

              Don't have an account?{' '}

              <Link
                to="/register"
                className="text-indigo-400 hover:text-indigo-300"
              >
                Register
              </Link>

            </p>

            <div className="border-t border-white/10 mt-6 pt-5 text-center text-xs text-slate-600">
              Educational blockchain voting prototype.
              <br />
              Use fictional demo voter information only.
            </div>

          </div>

        </div>

      </div>

    </div>
  );
}
```