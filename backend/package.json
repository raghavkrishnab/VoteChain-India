{
  "name": "voting-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "seed:admin": "node scripts/create-admin.js",
    "reset:elections": "node scripts/reset-elections.js",
    "dev:local": "node --env-file-if-exists=.env.localchain --watch src/server.js",
    "seed:admin:local": "node --env-file-if-exists=.env.localchain scripts/create-admin.js",
    "reset:elections:local": "node --env-file-if-exists=.env.localchain scripts/reset-elections.js --yes",
    "db:local": "node scripts/local-db.js",
    "copy-voters": "node scripts/copy-voters.js"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "form-data": "^4.0.4",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
